# Copy to .env; use your own cloud resources and local credential profile.
AWS_PROFILE=your-profile
AWS_REGION=ap-northeast-1
RAW_BUCKET=your-raw-bucket
TRADE_LAMBDA_FUNCTION=trade-analytics-ingestion
DBT_RAW_PROJECT=your-gcp-project
DBT_RAW_DATASET=trade_raw
TRADE_BQ_PROJECT=your-gcp-project
TRADE_BQ_DATASET=trade_analytics
TRADE_BQ_LOCATION=asia-northeast1
TRADE_DASHBOARD_FIRST_MONTH=2023-01-01
TRADE_DASHBOARD_AFTER_LAST_MONTH=2025-01-01
TRADE_DASHBOARD_CACHE_TTL=3600
TRADE_BQ_MAX_BYTES_BILLED=1000000000
AIRFLOW_UID=50000
# Set a Fernet key before starting Airflow.
FERNET_KEY=
# Set a private random secret before starting Airflow.
AIRFLOW__API_AUTH__JWT_SECRET=
