{
  "$defs": {
    "Availability": {
      "additionalProperties": false,
      "properties": {
        "reporter_code": {
          "title": "Reporter Code",
          "type": "string"
        },
        "cmd_code": {
          "title": "Cmd Code",
          "type": "string"
        },
        "months": {
          "items": {
            "format": "date",
            "type": "string"
          },
          "title": "Months",
          "type": "array"
        },
        "start_month": {
          "format": "date",
          "title": "Start Month",
          "type": "string"
        },
        "latest_data_month": {
          "format": "date",
          "title": "Latest Data Month",
          "type": "string"
        }
      },
      "required": [
        "reporter_code",
        "cmd_code",
        "months",
        "start_month",
        "latest_data_month"
      ],
      "title": "Availability",
      "type": "object"
    },
    "FileIndex": {
      "additionalProperties": false,
      "properties": {
        "monthly.json": {
          "$ref": "#/$defs/FileInfo"
        },
        "partners.json": {
          "$ref": "#/$defs/FileInfo"
        }
      },
      "required": [
        "monthly.json",
        "partners.json"
      ],
      "title": "FileIndex",
      "type": "object"
    },
    "FileInfo": {
      "additionalProperties": false,
      "properties": {
        "row_count": {
          "minimum": 0,
          "title": "Row Count",
          "type": "integer"
        },
        "bytes": {
          "exclusiveMinimum": 0,
          "title": "Bytes",
          "type": "integer"
        },
        "sha256": {
          "pattern": "^sha256:[a-f0-9]{64}$",
          "title": "Sha256",
          "type": "string"
        }
      },
      "required": [
        "row_count",
        "bytes",
        "sha256"
      ],
      "title": "FileInfo",
      "type": "object"
    },
    "MarketMetadata": {
      "additionalProperties": false,
      "properties": {
        "reporter_code": {
          "title": "Reporter Code",
          "type": "string"
        },
        "name": {
          "title": "Name",
          "type": "string"
        }
      },
      "required": [
        "reporter_code",
        "name"
      ],
      "title": "MarketMetadata",
      "type": "object"
    },
    "ProductMetadata": {
      "additionalProperties": false,
      "properties": {
        "cmd_code": {
          "title": "Cmd Code",
          "type": "string"
        },
        "name": {
          "title": "Name",
          "type": "string"
        },
        "is_parts": {
          "title": "Is Parts",
          "type": "boolean"
        }
      },
      "required": [
        "cmd_code",
        "name",
        "is_parts"
      ],
      "title": "ProductMetadata",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "2.0.0",
      "title": "Schema Version",
      "type": "string"
    },
    "snapshot_id": {
      "pattern": "^[a-f0-9]{32}$",
      "title": "Snapshot Id",
      "type": "string"
    },
    "generated_at": {
      "format": "date-time",
      "title": "Generated At",
      "type": "string"
    },
    "start_month": {
      "format": "date",
      "title": "Start Month",
      "type": "string"
    },
    "end_exclusive": {
      "format": "date",
      "title": "End Exclusive",
      "type": "string"
    },
    "latest_data_month": {
      "format": "date",
      "title": "Latest Data Month",
      "type": "string"
    },
    "currency": {
      "const": "USD",
      "title": "Currency",
      "type": "string"
    },
    "decimal_encoding": {
      "const": "string",
      "title": "Decimal Encoding",
      "type": "string"
    },
    "hhi_coverage_tolerance": {
      "const": "0.005",
      "title": "Hhi Coverage Tolerance",
      "type": "string"
    },
    "files": {
      "$ref": "#/$defs/FileIndex"
    },
    "valid_detail_count": {
      "minimum": 0,
      "title": "Valid Detail Count",
      "type": "integer"
    },
    "positive_amount_count": {
      "minimum": 0,
      "title": "Positive Amount Count",
      "type": "integer"
    },
    "row_target_met": {
      "title": "Row Target Met",
      "type": "boolean"
    },
    "markets": {
      "items": {
        "$ref": "#/$defs/MarketMetadata"
      },
      "title": "Markets",
      "type": "array"
    },
    "products": {
      "items": {
        "$ref": "#/$defs/ProductMetadata"
      },
      "title": "Products",
      "type": "array"
    },
    "availability": {
      "items": {
        "$ref": "#/$defs/Availability"
      },
      "title": "Availability",
      "type": "array"
    }
  },
  "required": [
    "schema_version",
    "snapshot_id",
    "generated_at",
    "start_month",
    "end_exclusive",
    "latest_data_month",
    "currency",
    "decimal_encoding",
    "hhi_coverage_tolerance",
    "files",
    "valid_detail_count",
    "positive_amount_count",
    "row_target_met",
    "markets",
    "products",
    "availability"
  ],
  "title": "SnapshotManifestV2",
  "type": "object"
}
