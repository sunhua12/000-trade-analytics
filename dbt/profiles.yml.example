trade_analytics:
  target: dev
  outputs:
    dev:
      type: bigquery
      method: oauth
      project: "{{ env_var('DBT_PROJECT', env_var('DBT_RAW_PROJECT', 'trade-analytics-508604')) }}"
      dataset: "{{ env_var('TRADE_BQ_DATASET', 'trade_analytics') }}"
      location: "{{ env_var('TRADE_BQ_LOCATION', 'asia-northeast1') }}"
      threads: 1
      maximum_bytes_billed: 1000000000
      job_execution_timeout_seconds: 180
