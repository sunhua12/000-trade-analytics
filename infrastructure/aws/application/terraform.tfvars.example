aws_region          = "ap-northeast-1"
aws_account_id      = "YOUR_ACCOUNT_ID"
raw_bucket_name     = "YOUR_EXISTING_RAW_BUCKET"
repository_name     = "trade-analytics-ingestion"
function_name       = "trade-analytics-ingestion"
execution_role_name = "trade-analytics-lambda-role"
image_uri           = "YOUR_ECR_URI@sha256:REPLACE_WITH_64_HEX_DIGEST"
# Preserve observed settings during adoption; evaluate concurrency quotas separately.
reserved_concurrency = -1
log_retention_days   = 30
image_tag_mutability = "MUTABLE"
